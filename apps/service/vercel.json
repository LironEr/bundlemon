{
  "version": 2,
  "buildCommand": "yarn add sodium-native@^4.0.0",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/v1/:path*",
      "destination": "/api/serverless.js",
      "maxDuration": 10
    },
    {
      "source": "/is-alive",
      "destination": "/api/serverless.js",
      "maxDuration": 5
    },
    {
      "source": "/health",
      "destination": "/api/serverless.js",
      "maxDuration": 10
    },
    {
      "source": "/cron/:taskId",
      "destination": "/api/serverless.js",
      "maxDuration": 180
    },
    {
      "source": "/internal/init-db",
      "destination": "/api/serverless.js",
      "maxDuration": 60
    }
  ],
  "functions": {
    "api/serverless.js": {
      "includeFiles": "node_modules/sodium-native/prebuilds/linux-x64/**"
    }
  },
  "crons": [
    {
      "path": "/cron/deleteStaleBranches",
      "schedule": "0 6 * * 6"
    },
    {
      "path": "/cron/deleteOldRecords",
      "schedule": "0 7 * * 6"
    }
  ]
}
