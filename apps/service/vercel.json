{
  "version": 2,
  "buildCommand": "yarn add sodium-native@^4.0.0",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/v1/:path*",
      "destination": "/api/serverless.js"
    },
    {
      "source": "/is-alive",
      "destination": "/api/serverless.js"
    },
    {
      "source": "/health",
      "destination": "/api/serverless.js"
    },
    {
      "source": "/cron/tasks",
      "destination": "/api/tasks.js"
    },
    {
      "source": "/internal/init-db",
      "destination": "/api/tasks.js"
    }
  ],
  "functions": {
    "api/serverless.js": {
      "maxDuration": 10,
      "includeFiles": "node_modules/sodium-native/prebuilds/linux-x64/**"
    },
    "api/tasks.js": {
      "maxDuration": 180,
      "includeFiles": "node_modules/sodium-native/prebuilds/linux-x64/**"
    }
  },
  "crons": [
    {
      "path": "/cron/tasks",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/cron/tasks",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/cron/tasks",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/cron/tasks",
      "schedule": "0 18 * * *"
    }
  ]
}
