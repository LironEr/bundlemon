{
  "private": true,
  "license": "MIT",
  "scripts": {
    "test-packages": "yarn nx run-many --target=test --projects tag:type:lib --verbose",
    "build-packages": "nx run-many --target=build --projects tag:type:lib --verbose",
    "build-packages:watch": "nx watch --projects tag:type:lib -- nx run \\$NX_PROJECT_NAME:build",
    "lint-packages": "yarn nx run-many --target=lint --projects tag:type:lib  --verbose",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@emotion/babel-plugin": "11.13.5",
    "@nx/esbuild": "23.2.1",
    "@nx/eslint": "23.2.1",
    "@nx/eslint-plugin": "23.2.1",
    "@nx/jest": "23.2.1",
    "@nx/js": "23.2.1",
    "@nx/react": "23.2.1",
    "@nx/vite": "23.2.1",
    "@nx/vitest": "23.2.1",
    "@nx/web": "23.2.1",
    "@swc-node/register": "1.12.1",
    "@swc/core": "1.16.2",
    "@types/jest": "30.0.0",
    "@types/jest-when": "^3.5.2",
    "@types/node": "^18.16.9",
    "@typescript-eslint/eslint-plugin": "8.71.1",
    "@typescript-eslint/parser": "8.71.1",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.27.1",
    "eslint": "9.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.16.6",
    "eslint-plugin-prettier": "^5.5.0",
    "globals": "^17.0.0",
    "husky": "^8.0.3",
    "jest": "30.3.0",
    "jest-util": "30.0.5",
    "jest-when": "^3.5.2",
    "lint-staged": "^15.2.2",
    "nx": "23.2.1",
    "prettier": "^3.0.2",
    "ts-jest": "29.4.9",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.58.0"
  },
  "engines": {
    "yarn": "^1.10.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/*"
  ],
  "dependencies": {}
}
